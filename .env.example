# Copy to .env and fill in. .env is gitignored and must never be committed.

# Which LLM provider to use: "mock" (no API key, deterministic baseline) or "openai".
# Defaults to "mock" so the app, tests and eval run with no key and no cost.
LLM_PROVIDER=openai

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Models (only used by the openai provider). Configurable per the brief.
EXTRACTION_MODEL=gpt-5-mini
MATCHING_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Networking / behaviour
REQUEST_TIMEOUT_S=60
LOG_LEVEL=INFO
